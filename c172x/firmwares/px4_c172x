#!/bin/sh
#
# @name PteroSim Cessna 172
# @type Fixedwing
# @class Plane
#
# Copied from 4003_gz_rc_cessna with Gazebo-specific params removed.
# Channel mapping (matches Controls.xml):
#   HIL Channel 0: Engine (throttle)
#   HIL Channel 1: Elevator
#   HIL Channel 2: Aileron (single channel, controls both L+R via JSBSim)
#   HIL Channel 3: Rudder
#   HIL Channel 4: Flaps
#

. ${R}etc/init.d/rc.fw_defaults

param set-default SENS_EN_ARSPDSIM 1

# ── Airspeed (full-size C172, NOT RC model) ────────────────────────────
# PX4 defaults (10/15/20 m/s) are for RC planes. C172: Vs1=25, Vy=38, Vno=66 m/s
# CRITICAL: PX4 scales rate controller gains by (trim/actual)^2.
# With default trim=15 and actual=30+, gains were reduced 75% → spiral divergence.

param set-default FW_AIRSPD_STALL 22
param set-default FW_AIRSPD_MIN 28
param set-default FW_AIRSPD_TRIM 38
param set-default FW_AIRSPD_MAX 60

# ── Airframe ────────────────────────────────────────────────────────────

param set-default CA_AIRFRAME 1
param set-default COM_PREARM_MODE 2

# ── Motor (single tractor prop) ─────────────────────────────────────────

param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_PX 0.3

# ── Control Surfaces ────────────────────────────────────────────────────
# Gazebo uses 6 CS (dual ailerons + spoilers), PteroSim uses 4 (single aileron via JSBSim)

param set-default CA_SV_CS_COUNT 4

# CS0 → Elevator (HIL Channel 1)
param set-default CA_SV_CS0_TYPE 3
param set-default CA_SV_CS0_TRQ_P 1.0

# CS1 → Aileron (HIL Channel 2) — single channel, full roll authority
param set-default CA_SV_CS1_TYPE 1
param set-default CA_SV_CS1_TRQ_R -1.0

# CS2 → Rudder (HIL Channel 3)
param set-default CA_SV_CS2_TYPE 4
param set-default CA_SV_CS2_TRQ_Y 1.0

# CS3 → Flaps (HIL Channel 4)
param set-default CA_SV_CS3_TYPE 9

# ── Output Function Mapping ─────────────────────────────────────────────
# PWM_MAIN_FUNCn determines HIL_ACTUATOR_CONTROLS channel order
# 101=Motor1, 201=Servo1(CS0), 202=Servo2(CS1), ...

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 201
param set-default PWM_MAIN_FUNC3 202
param set-default PWM_MAIN_FUNC4 203
param set-default PWM_MAIN_FUNC5 204
param set-default PWM_MAIN_FUNC6 401

# ── Flight Controller Tuning (from Gazebo rc_cessna — identical) ────────

param set-default FW_PR_P 0.9
param set-default FW_PR_FF 0.2
param set-default FW_PR_I 0.5
param set-default TRIM_PITCH 0

param set-default FW_RR_FF 0.8
param set-default FW_RR_P 0.8
param set-default FW_RR_I 1.0
param set-default FW_R_RMAX 56.15

param set-default FW_YR_FF 0.4
# FW_YR_P set in Ground Steering section below
param set-default FW_YR_I 1.0

# ── Performance Limits ──────────────────────────────────────────────────

param set-default FW_PSP_OFF 0
param set-default FW_P_LIM_MIN -15
param set-default FW_T_CLMB_MAX 3
param set-default FW_T_SINK_MAX 3.5
param set-default FW_T_SINK_MIN 4
# JSBSim c172x measured: idle sink ~4 m/s, full-throttle climb 3.5 m/s; SINK_MIN=2 pinned TECS throttle FF at 0 -> idle-dive crash
# FW_THR_MIN stays 0: 0.10 made the plane roll 3 km after touchdown (thr never idles); dive fix is SINK_MIN/CLMB_MAX+geometry
param set-default FW_R_LIM 35

# ── Navigation ──────────────────────────────────────────────────────────

param set-default NPFG_PERIOD 12
param set-default NAV_ACC_RAD 15
param set-default NAV_DLL_ACT 2
param set-default MIS_TAKEOFF_ALT 30

# ── Takeoff / Landing ──────────────────────────────────────────────────

param set-default FW_LND_ANG 8
param set-default RWTO_TKOFF 1
param set-default FW_SPOILERS_LND 0.4

# ── Weathervane ─────────────────────────────────────────────────────────

param set-default FW_W_EN 1

# ── Safety ──────────────────────────────────────────────────────────────

param set-default FD_ESCS_EN 0

# ── Ground Steering ─────────────────────────────────────────────────────
# JSBSim c172x nosewheel is mechanically linked to rudder.
# PX4 wheel controller (func 401) is NOT mapped — conflicts with yaw rate controller.
# Ground steering is handled by yaw rate controller via rudder (ch3).
# Increase yaw rate P to counter p_factor=10 during ground roll.

param set-default FW_YR_P 8.0

# ── Faster rotation ─────────────────────────────────────────────────────
# Rotate earlier (Vr slightly below Vs1) and pitch up more aggressively
param set-default RWTO_ROT_AIRSPD 18
param set-default RWTO_PSP 3

param set-default FW_LND_USETER 0
# ── Force-set params (param set-default won't override built-in defaults) ──
param set RWTO_PSP 3
param set RWTO_ROT_AIRSPD 18
param set TRIM_PITCH 0
param set FW_YR_P 8.0
param set RWTO_TKOFF 1
param set FW_LND_USETER 0
