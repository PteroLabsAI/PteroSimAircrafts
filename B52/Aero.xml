<?xml version="1.0"?>
<aerodynamics>
  <!--The YASim geometry supplies scale and incidence. These coefficients approximate the FlightGear approach and clean cruise conditions.-->
  <function name="aero/coefficient/b52-lift">
    <sum>
      <table>
        <independentVar lookup="row">aero/alpha-rad</independentVar>
        <tableData>
              -0.7  -0.34
             -0.35  -0.7
             -0.18  -0.4
                 0  0.5
               0.1  0.94
               0.2  1.34
              0.26  1.52
              0.33  1.12
               0.7  0.62
          </tableData>
      </table>
      <product>
        <property>fcs/flap-pos-norm</property>
        <value>0.68</value>
      </product>
      <product>
        <property>fcs/elevator-pos-norm</property>
        <value>0.09</value>
      </product>
    </sum>
  </function>
  <axis name="LIFT">
    <function name="aero/force/lift">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <sum>
          <property>aero/coefficient/b52-lift</property>
          <product>
            <value>5.5</value>
            <product>
              <property>aero/ci2vel</property>
              <property>velocities/q-aero-rad_sec</property>
            </product>
          </product>
        </sum>
      </product>
    </function>
  </axis>
  <axis name="DRAG">
    <function name="aero/force/drag">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <sum>
          <value>0.017</value>
          <product>
            <value>0.046</value>
            <property>aero/coefficient/b52-lift</property>
            <property>aero/coefficient/b52-lift</property>
          </product>
          <product>
            <value>0.03</value>
            <property>fcs/flap-pos-norm</property>
          </product>
          <product>
            <value>0.018</value>
            <property>gear/gear-pos-norm</property>
          </product>
          <product>
            <value>0.16</value>
            <property>aero/beta-rad</property>
            <property>aero/beta-rad</property>
          </product>
          <table>
            <independentVar lookup="row">velocities/mach</independentVar>
            <tableData>
                 0  0
              0.76  0
              0.85  0.006
              0.91  0.025
              1.05  0.065
          </tableData>
          </table>
        </sum>
      </product>
    </function>
  </axis>
  <axis name="SIDE">
    <function name="aero/force/side">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <sum>
          <product>
            <value>-0.75</value>
            <property>aero/beta-rad</property>
          </product>
          <product>
            <value>0.12</value>
            <property>fcs/rudder-pos-norm</property>
          </product>
        </sum>
      </product>
    </function>
  </axis>
  <axis name="ROLL">
    <function name="aero/force/roll">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <property>metrics/bw-ft</property>
        <sum>
          <product>
            <value>-0.09</value>
            <property>aero/beta-rad</property>
          </product>
          <product>
            <value>-0.49</value>
            <product>
              <property>aero/bi2vel</property>
              <property>velocities/p-aero-rad_sec</property>
            </product>
          </product>
          <product>
            <value>0.13</value>
            <product>
              <property>aero/bi2vel</property>
              <property>velocities/r-aero-rad_sec</property>
            </product>
          </product>
          <product>
            <value>0.065</value>
            <property>fcs/left-aileron-pos-norm</property>
          </product>
          <product>
            <value>0.012</value>
            <property>fcs/rudder-pos-norm</property>
          </product>
        </sum>
      </product>
    </function>
  </axis>
  <axis name="PITCH">
    <function name="aero/force/pitch">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <property>metrics/cbarw-ft</property>
        <sum>
          <value>0.035</value>
          <product>
            <value>-0.77</value>
            <property>aero/alpha-rad</property>
          </product>
          <product>
            <value>-0.33</value>
            <property>fcs/elevator-pos-norm</property>
          </product>
          <product>
            <value>-0.05</value>
            <property>fcs/flap-pos-norm</property>
          </product>
          <product>
            <value>-22</value>
            <product>
              <property>aero/ci2vel</property>
              <property>velocities/q-aero-rad_sec</property>
            </product>
          </product>
        </sum>
      </product>
    </function>
  </axis>
  <axis name="YAW">
    <function name="aero/force/yaw">
      <product>
        <property>aero/qbar-psf</property>
        <property>metrics/Sw-sqft</property>
        <property>metrics/bw-ft</property>
        <sum>
          <product>
            <value>0.13</value>
            <property>aero/beta-rad</property>
          </product>
          <product>
            <value>-0.22</value>
            <product>
              <property>aero/bi2vel</property>
              <property>velocities/r-aero-rad_sec</property>
            </product>
          </product>
          <product>
            <value>-0.035</value>
            <property>fcs/rudder-pos-norm</property>
          </product>
          <product>
            <value>-0.008</value>
            <property>fcs/left-aileron-pos-norm</property>
          </product>
        </sum>
      </product>
    </function>
  </axis>
</aerodynamics>
