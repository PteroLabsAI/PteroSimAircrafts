#!/bin/sh
#
# @name PteroSim Boeing B-52 Stratofortress
# @type Fixedwing
# @class Plane
#
. ${R}etc/init.d/rc.fw_defaults

param set-default SENS_EN_ARSPDSIM 1
# PteroSim does not send an electrical-supply status for these turbines.
param set-default CBRK_SUPPLY_CHK 894281
# The default 100 m/s limit rejects GNSS velocity near the B-52's rotation speed.
param set-default EKF2_VEL_LIM 280
param set-default CA_AIRFRAME 1
param set-default CA_ROTOR_COUNT 1
param set-default CA_ROTOR0_PX 0.3
param set-default CA_SV_CS_COUNT 4
param set-default CA_SV_CS0_TYPE 3
param set-default CA_SV_CS0_TRQ_P 1.0
param set-default CA_SV_CS1_TYPE 1
param set-default CA_SV_CS1_TRQ_R -1.0
param set-default CA_SV_CS2_TYPE 4
param set-default CA_SV_CS2_TRQ_Y 1.0
param set-default CA_SV_CS3_TYPE 9

# One throttle output is shared by all eight turbines in Controls.xml.
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 201
param set-default PWM_MAIN_FUNC3 202
param set-default PWM_MAIN_FUNC4 203
param set-default PWM_MAIN_FUNC5 204
# Offboard actuator controls 1 to 3 drive wheel brakes, ground steering and landing gear.
param set-default PWM_MAIN_FUNC6 301
param set-default PWM_MAIN_FUNC7 302
param set-default PWM_MAIN_FUNC8 303

# Equivalent airspeeds in metres per second.
param set-default FW_AIRSPD_STALL 73
param set-default FW_AIRSPD_MIN 90
param set-default FW_AIRSPD_TRIM 113
param set-default FW_AIRSPD_MAX 155
param set-default FW_PR_P 0.55
param set-default FW_PR_I 0.18
param set-default FW_PR_FF 0.18
param set-default FW_RR_P 0.45
param set-default FW_RR_I 0.15
param set-default FW_RR_FF 0.18
param set-default FW_YR_P 0.3
param set-default FW_YR_I 0.08
param set-default FW_YR_FF 0.15
param set-default FW_P_RMAX_POS 18
param set-default FW_P_RMAX_NEG 18
param set-default FW_R_RMAX 28
param set-default FW_R_LIM 35
param set-default FW_P_LIM_MIN -12
param set-default FW_P_LIM_MAX 16
param set-default FW_T_CLMB_MAX 10
param set-default FW_T_SINK_MIN 4
param set-default FW_T_SINK_MAX 10
param set-default FW_THR_TRIM 0.35
param set-default NPFG_PERIOD 35
param set-default NAV_ACC_RAD 200
param set-default NAV_LOITER_RAD 3500
param set-default MIS_TAKEOFF_ALT 150
param set-default RWTO_TKOFF 1
param set-default RWTO_PSP 5
