# ArduPlane SITL parameters for explora (eXplora dual-motor tailsitter):
#   sim_vehicle.py -v ArduPlane --model JSON:<host> --add-param-file=<this file>
# Self-contained: with --model JSON the binary loads no frame defaults (standard_vtol convention), so every Q_ value is here.
# Source: the real aircraft's dump, upstream parameters/Ardupilot/2022-10-17_Pixhawk1.param (Plane 4.2 names),
# translated to the current names the standard_vtol and c172x files use: ARSPD_FBW_MIN/MAX -> AIRSPEED_MIN/MAX,
# TRIM_ARSPD_CM 1600 -> AIRSPEED_CRUISE 16, LIM_ROLL_CD 5000 -> ROLL_LIMIT_DEG 50, LIM_PITCH_MIN/MAX -3000/4000 ->
# PTCH_LIM_MIN_DEG -30 / PTCH_LIM_MAX_DEG 40. Everything not listed is ArduPlane's own default.
#
# NOT copied from the dump, because it is the real board's hardware and calibration and would corrupt a body-aligned
# simulated IMU: AHRS_ORIENTATION 2 (Yaw90 board mount) and COMPASS_ORIENT 4 are 0 here; INS_ACC*/INS_GYR* offsets, scales
# and device ids; COMPASS_OFS/DIA/ODI; ARSPD_TYPE 2 with ARSPD_OFFSET 1997 / ARSPD_RATIO 2.53 (the real MS4525) is
# ARSPD_TYPE 100 (SITL sensor, the JSON "airspeed" field, as c172x); BATT_* pins and multipliers; ARMING_CHECK 0;
# SERVO5_TRIM 1552 / SERVO6_TRIM 1495 (the real linkage's standing offset, which would arrive as +0.10 / -0.01 on
# fcs/servo-0/1-cmd-norm through PWMToServo) are 1500. SERVO6_REVERSED 1 stays: FlightControl.xml's right-elevon gain +1
# assumes the autopilot has already flipped that channel.

# ---- frame: QuadPlane tailsitter, two motors, no thrust vectoring (Q_TAILSIT_VFGAIN = VHGAIN = 0), 60 deg transition angle
Q_ENABLE 1
Q_FRAME_CLASS 10
Q_FRAME_TYPE 1
Q_MAV_TYPE 19
Q_TAILSIT_ENABLE 1
Q_TAILSIT_ANGLE 60
Q_TAILSIT_ANG_VT 60
Q_TAILSIT_VFGAIN 0
Q_TAILSIT_VHGAIN 0
Q_TAILSIT_MOTMX 0
Q_TAILSIT_INPUT 0
Q_TAILSIT_RAT_FW 60
Q_TAILSIT_RAT_VT 60
Q_TAILSIT_THR_VT 60
Q_TAILSIT_MIN_VO 4
Q_TAILSIT_DSKLD 18
Q_TAILSIT_RLL_MX 30
Q_TAILSIT_GSCMAX 4
Q_TAILSIT_GSCMIN 0.4
Q_TAILSIT_GSCMSK 11
Q_TRANSITION_MS 2000
Q_BACKTRANS_MS 3000
Q_TRAN_PIT_MAX 3
Q_ANGLE_MAX 2000
# Tailsitters are exempt from the "Q_ASSIST_SPEED is not set" arming check (AP_Arming_Plane.cpp:
# `is_zero(plane.quadplane.assist.speed) && !plane.quadplane.tailsitter.enabled()`); the real aircraft flies 0.
Q_ASSIST_SPEED 0
Q_ASSIST_ANGLE 30
Q_ASSIST_DELAY 0.5
# The real aircraft flies Q_WVANE_ENABLE 3. The model hovers leaning ~10 deg (the washed strips' normal force), which
# weathervaning reads as wind and chases. 0 here.
Q_WVANE_ENABLE 0
Q_WVANE_GAIN 2
Q_WVANE_ANG_MIN 1
Q_WVANE_LAND 3

# ---- outputs (Controls.xml: channel = SERVOn - 1). SERVO9/10 = ThrottleLeft/Right, SERVO5/6 = ElevonLeft/Right.
# The real dump also assigns SERVO3/4 = TiltMotorRight/Left, which never leave trim with VFGAIN = VHGAIN = 0; not bound in the sim.
SERVO5_FUNCTION 77
SERVO5_MIN 1000
SERVO5_MAX 2000
SERVO5_TRIM 1500
SERVO5_REVERSED 0
SERVO6_FUNCTION 78
SERVO6_MIN 1000
SERVO6_MAX 2000
SERVO6_TRIM 1500
SERVO6_REVERSED 1
SERVO9_FUNCTION 73
SERVO9_MIN 1000
SERVO9_MAX 2000
SERVO9_TRIM 1000
SERVO10_FUNCTION 74
SERVO10_MIN 1000
SERVO10_MAX 2000
SERVO10_TRIM 1000
MIXING_GAIN 0.7
MIXING_OFFSET 0

# ---- VTOL motors. PWM 1000..2000 is what Controls.xml reads as throttle 0..1; PWM type left at the SITL default (the real
# board uses DShot, Q_M_PWM_TYPE 4). Q_M_THST_HOVER: the real aircraft's learned 0.235 is inconsistent with 3.4 kg on two
# 14x8 props (QPROP, README.md); 0.42 is what the JSBSim model needs (hover duty 0.612 -> x = (0.612 - 0.15) / 0.8 = 0.578 -> 0.35 x + 0.65 x^2 = 0.419), and Q_M_HOVER_LEARN 2 keeps learning it.
Q_M_PWM_MIN 1000
Q_M_PWM_MAX 2000
Q_M_SPIN_MIN 0.15
Q_M_SPIN_MAX 0.95
Q_M_SPIN_ARM 0
Q_M_THST_EXPO 0.65
Q_M_THST_HOVER 0.42
Q_M_HOVER_LEARN 2
Q_M_YAW_HEADROOM 200
Q_M_SPOOL_TIME 0.25
Q_THROTTLE_EXPO 0.2

# ---- VTOL attitude and rate loops (the tune flown on the real aircraft, unchanged; the model's hover authority is a
# momentum-theory upper bound, README.md open questions)
Q_A_ANG_PIT_P 3
Q_A_ANG_RLL_P 4
Q_A_ANG_YAW_P 3.5
Q_A_ANG_LIM_TC 1
Q_A_INPUT_TC 0.2
Q_A_RATE_FF_ENAB 1
Q_A_RAT_PIT_P 0.17
Q_A_RAT_PIT_I 0.2
Q_A_RAT_PIT_D 0.005
Q_A_RAT_PIT_FF 0.2
Q_A_RAT_PIT_IMAX 0.5
Q_A_RAT_PIT_FLTD 10
Q_A_RAT_PIT_FLTE 0
Q_A_RAT_PIT_FLTT 16
Q_A_RAT_PIT_SMAX 50
Q_A_RAT_RLL_P 0.2
Q_A_RAT_RLL_I 0.15
Q_A_RAT_RLL_D 0.02
Q_A_RAT_RLL_FF 0.18
Q_A_RAT_RLL_IMAX 0.5
Q_A_RAT_RLL_FLTD 10
Q_A_RAT_RLL_FLTE 0
Q_A_RAT_RLL_FLTT 16
Q_A_RAT_RLL_SMAX 50
Q_A_RAT_YAW_P 0.4
Q_A_RAT_YAW_I 0.5
Q_A_RAT_YAW_D 0.01
Q_A_RAT_YAW_FF 0.2
Q_A_RAT_YAW_IMAX 0.5
Q_A_RAT_YAW_FLTD 0
Q_A_RAT_YAW_FLTE 2.5
Q_A_RAT_YAW_FLTT 16
Q_A_RAT_YAW_SMAX 50
Q_A_ACCEL_P_MAX 30000
Q_A_ACCEL_R_MAX 25000
Q_A_ACCEL_Y_MAX 27000
Q_A_RATE_P_MAX 75
Q_A_RATE_R_MAX 75
Q_A_RATE_Y_MAX 75
Q_A_SLEW_YAW 6000
Q_A_THR_MIX_MIN 0.1
Q_A_THR_MIX_MAN 0.9
Q_A_THR_MIX_MAX 0.9

# ---- VTOL position loops and speeds (dump)
Q_P_POSXY_P 0.5
Q_P_POSZ_P 1
Q_P_VELXY_P 1
Q_P_VELXY_I 0.5
Q_P_VELXY_D 0.25
Q_P_VELXY_IMAX 1000
Q_P_VELXY_FLTD 5
Q_P_VELXY_FLTE 5
Q_P_VELZ_P 5
Q_P_ACCZ_P 0.3
Q_P_ACCZ_I 1
Q_P_ACCZ_IMAX 800
Q_P_ACCZ_FLTE 10
Q_P_JERK_XY 2
Q_P_JERK_Z 5
Q_ACCEL_Z 250
Q_VELZ_MAX 500
Q_VELZ_MAX_DN 150
Q_WP_SPEED 500
Q_WP_SPEED_UP 300
Q_WP_SPEED_DN 150
Q_WP_ACCEL 100
Q_WP_ACCEL_Z 100
Q_WP_RADIUS 200
Q_LOIT_SPEED 300
Q_LOIT_ACC_MAX 100
Q_LOIT_BRK_ACCEL 50
Q_LOIT_BRK_DELAY 1
Q_LOIT_BRK_JERK 250
Q_RTL_ALT 20
Q_RTL_MODE 1
Q_LAND_FINAL_ALT 10
Q_TRANS_DECEL 4

# ---- fixed-wing envelope (dump: ARSPD_FBW_MIN 12, ARSPD_FBW_MAX 20, TRIM_ARSPD_CM 1600, TRIM_THROTTLE 30). The model's stall
# speed is 11.55 m/s at 3.4 kg and its 16 m/s trim needs throttle 0.40 (the dump's 30 is
# only the TECS feed-forward). The airspeed sensor is the SITL type: the JSON "airspeed" field (Sensors.xml airspeed).
ARSPD_TYPE 100
ARSPD_USE 1
AIRSPEED_MIN 12
AIRSPEED_CRUISE 16
AIRSPEED_MAX 20
TRIM_THROTTLE 30
THR_MAX 90
THR_MIN 0
THR_SLEWRATE 100
ROLL_LIMIT_DEG 50
PTCH_LIM_MIN_DEG -30
PTCH_LIM_MAX_DEG 40
STALL_PREVENTION 1
STAB_PITCH_DOWN 2
SCALING_SPEED 15
KFF_RDDRMIX 0.02

# ---- fixed-wing loops (dump)
RLL2SRV_TCONST 0.3
RLL2SRV_RMAX 90
RLL_RATE_P 0.17
RLL_RATE_I 0.13
RLL_RATE_D 0.0022
RLL_RATE_FF 0.092
RLL_RATE_IMAX 0.8
RLL_RATE_FLTD 15
RLL_RATE_FLTE 0
RLL_RATE_FLTT 5.305164
RLL_RATE_SMAX 150
PTCH2SRV_TCONST 0.45
PTCH2SRV_RLL 1
PTCH2SRV_RMAX_UP 90
PTCH2SRV_RMAX_DN 90
PTCH_RATE_P 0.06
PTCH_RATE_I 0.1
PTCH_RATE_D 0.003
PTCH_RATE_FF 0.09
PTCH_RATE_IMAX 0.9
PTCH_RATE_FLTD 15
PTCH_RATE_FLTE 0
PTCH_RATE_FLTT 3.536776
PTCH_RATE_SMAX 150
TECS_CLMB_MAX 5
TECS_SINK_MIN 2
TECS_SINK_MAX 5
TECS_TIME_CONST 5
TECS_THR_DAMP 0.5
TECS_INTEG_GAIN 0.1
TECS_SPD_OMEGA 2
TECS_HGT_OMEGA 3
TECS_RLL2THR 10
TECS_SPDWEIGHT 1
TECS_PTCH_FF_V0 12
TECS_VERT_ACC 7
NAVL1_PERIOD 21
NAVL1_DAMPING 0.75
NAVL1_XTRACK_I 0.02
WP_RADIUS 2
WP_LOITER_RAD 25
RTL_RADIUS 35

# ---- sensors and body frame: the simulated IMU is body-aligned (Airframe.xml keeps the sensors in the plane frame, as the
# ArduPilot tailsitter guide asks: "AHRS_ORIENTATION, the accelerometer calibration and Level trim should all be done for fixed
# wing flight"); the dump's 2 / 4 are the real board mount.
AHRS_ORIENTATION 0
COMPASS_ORIENT 0
SCHED_LOOP_RATE 300
BATT_CAPACITY 5000
BATT_LOW_VOLT 18.6
BATT_FS_LOW_ACT 4

# ---- flight modes as flown (dump): 7 CRUISE, 19 QLOITER, 5 FBWA, 17 QSTABILIZE, 12 LOITER, 0 MANUAL
FLTMODE1 7
FLTMODE2 19
FLTMODE3 5
FLTMODE4 17
FLTMODE5 12
FLTMODE6 0
