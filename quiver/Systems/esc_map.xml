<?xml version="1.0"?>
<!-- X6 Plus ESC throttle command -> the motor voltage (V) its speed needs, per Hobbywing 54 V row, V = rpm/Kv + R*(Q*2*pi*Kv/60 + I0) with Engines/X6PlusG2.xml -->
<!-- Over supply-volts: the ESC holds rpm whatever the bus, until the bus is lower than that voltage (the clip to 1). Without a Battery.xml supply-volts is maxvolts, 54 V. -->
<!-- First two points, 0 .. 0.0572: 33 -> 35 % slope extended to 0 V, extrapolated, no data. Static map: the ESC's own speed loop is not modelled. -->
<system name="Quiver ESC map">
  <channel name="ESC 0">
    <fcs_function name="fcs/esc/voltage-norm[0]">
      <function>
        <quotient>
          <table>
            <independentVar lookup="row">fcs/throttle-cmd-norm[0]</independentVar>
            <tableData>
            0.0000  0.000
            0.0572  0.000
            0.3300  15.717
            0.3500  16.869
            0.3700  18.052
            0.3900  19.243
            0.4200  21.040
            0.4500  22.806
            0.4800  24.513
            0.5100  26.156
            0.5400  27.733
            0.5700  29.243
            0.6000  30.706
            0.6300  32.124
            0.6600  33.528
            0.6900  34.906
            0.7200  36.270
            0.7500  37.605
            0.7800  38.885
            0.8100  40.081
            0.8400  41.165
            0.8700  42.099
            0.9000  42.858
            1.0000  44.095
            </tableData>
          </table>
          <property>propulsion/engine[0]/supply-volts</property>
        </quotient>
      </function>
      <clipto> <min> 0 </min> <max> 1 </max> </clipto>
      <output>fcs/throttle-pos-norm[0]</output>
    </fcs_function>
  </channel>
