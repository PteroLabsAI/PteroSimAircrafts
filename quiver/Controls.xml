<?xml version="1.0"?>
<!--
  Which channel from the autopilot drives what on this vehicle. The attributes are F450's (its Controls.xml):
  channel, the number the autopilot sends; type and index, the Propulsion.xml engine it drives; in / out, the range
  in and the range out, absent meaning 0 to 1.

  Both autopilots take the four motors in the model's own order: 0 front right, 1 aft left, 2 front left, 3 aft right.

  The X6 Plus ESC runs from 1050 to 1950 us (Arrow's MOT_PWM_MIN/MAX), and Systems/esc_map.xml takes that range as 0..1
  and holds its shape. ArduPilot's PWM reaches this file as (PWM - 1000) / 1000 (PteroSimHIL ArduPilotProtocol.cpp
  PWMToMotor), so 1050..1950 arrives as 0.05..0.95 and is stretched back onto 0..1. PX4 already sends its motors as
  0..1 between its own PWM minimum and maximum, which is the same span.
-->
<control_bindings stack="ArduPilot">
  <binding stack="ArduPilot" channel="0" type="Motor" index="0" in="0.05 0.95" out="0 1" label="front right"/>
  <binding stack="ArduPilot" channel="1" type="Motor" index="1" in="0.05 0.95" out="0 1" label="aft left"/>
  <binding stack="ArduPilot" channel="2" type="Motor" index="2" in="0.05 0.95" out="0 1" label="front left"/>
  <binding stack="ArduPilot" channel="3" type="Motor" index="3" in="0.05 0.95" out="0 1" label="aft right"/>
  <!-- The A8 mini as a servo mount on SERVO5-7 (firmwares/ardupilot_quiver.param), the way x500 binds its CGO3 -->
  <binding stack="ArduPilot" channel="4" type="Gimbal" index="0" in="-1 1" out="-45 45" label="gimbal roll"/>
  <binding stack="ArduPilot" channel="5" type="Gimbal" index="1" in="-1 1" out="-90 90" label="gimbal pitch"/>
  <binding stack="ArduPilot" channel="6" type="Gimbal" index="2" in="-1 1" out="-180 180" label="gimbal yaw"/>

  <binding stack="PX4" channel="0" type="Motor" index="0" label="front right"/>
  <binding stack="PX4" channel="1" type="Motor" index="1" label="aft left"/>
  <binding stack="PX4" channel="2" type="Motor" index="2" label="front left"/>
  <binding stack="PX4" channel="3" type="Motor" index="3" label="aft right"/>
</control_bindings>
