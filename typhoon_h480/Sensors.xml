<?xml version="1.0"?>
<!--
  A sidecar: JSBSim never reads this file. Metres and degrees from the centre of mass, X forward, Y right, Z up, as in
  Visual.xml. Rates and noise are the components' own defaults.
  imu, gps, barometer  at the body mesh's origin, near the centre of the airframe.
  cgo3_camera  on the CGO3 gimbal (Payloads.xml), at the lens: the optical pupil's front face is 0.069 m ahead of the
               gimbal's centre (meshes/cgo3_camera_link__cgo3_camera_visual.glb). Field of view 115 deg, the CGO3+'s
               "Blickfeld" in Yuneec's Typhoon H data (NOTICE).
-->
<sensors>
  <sensor type="imu" name="imu" xyz="0.00621254316 0 -0.00844575019"/>
  <sensor type="gps" name="gps" xyz="0.00621254316 0 -0.00844575019"/>
  <sensor type="barometer" name="barometer" xyz="0.00621254316 0 -0.00844575019"/>
  <sensor type="camera" name="cgo3_camera" parent="cgo3" xyz="0.069 0 0" field_of_view="115"/>
</sensors>
