<?xml version='1.0' encoding='utf-8'?>
<!--
  maxvolts          16.8 V: the POWER 4's four cells full at 4.2 V each (NOTICE).
  velocityconstant  1000 rpm/V, coilresistance 0.012 ohm, noloadcurrent 0: Yuneec publishes no motor data; chosen.
-->
<brushless_dc_motor name="h480_motor">
  <maxvolts>16.8</maxvolts>
  <velocityconstant>1000</velocityconstant>
  <coilresistance>0.012</coilresistance>
  <noloadcurrent>0</noloadcurrent>
</brushless_dc_motor>
