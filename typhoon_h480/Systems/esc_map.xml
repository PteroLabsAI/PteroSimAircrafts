<?xml version='1.0' encoding='utf-8'?>
<!--
  The ESC: throttle command c -> fcs/throttle-pos-norm[n], the share of the full pack's 16.8 V it puts across the motor
  to hold the rotor at c x 1000 rad/s (the full-command speed NOTICE names). V = omega / Kv + I R with
  Engines/h480_motor.xml's Kv and coil resistance; I carries the propeller's torque, which goes as omega squared.
  speed_share  0.5684105 = 1000 rad/s / (1000 rpm/V x 2 pi / 60) / 16.8 V
  load_share   0.0073778 = 10.329 A x 0.012 ohm / 16.8 V: 10.329 A = Kv x 0.09863 N m, the torque at 1000 rad/s at sea
               level from Engines/h480_prop.xml's C_POWER at J 0 (98.63 W / 1000 rad/s)
-->
<system name="Typhoon H480 ESC">
  <function type="template" name="h480-duty">
    <sum>
      <product>
        <value>0.5684105</value>
        <p>#</p>
      </product>
      <product>
        <value>0.0073778</value>
        <p>#</p>
        <p>#</p>
      </product>
    </sum>
  </function>
  <channel name="ESC">
    <fcs_function name="fcs/esc/duty[0]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[0]</property>
      </function>
      <output>fcs/throttle-pos-norm[0]</output>
    </fcs_function>
    <fcs_function name="fcs/esc/duty[1]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[1]</property>
      </function>
      <output>fcs/throttle-pos-norm[1]</output>
    </fcs_function>
    <fcs_function name="fcs/esc/duty[2]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[2]</property>
      </function>
      <output>fcs/throttle-pos-norm[2]</output>
    </fcs_function>
    <fcs_function name="fcs/esc/duty[3]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[3]</property>
      </function>
      <output>fcs/throttle-pos-norm[3]</output>
    </fcs_function>
    <fcs_function name="fcs/esc/duty[4]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[4]</property>
      </function>
      <output>fcs/throttle-pos-norm[4]</output>
    </fcs_function>
    <fcs_function name="fcs/esc/duty[5]">
      <function>
        <property apply="h480-duty">fcs/throttle-cmd-norm[5]</property>
      </function>
      <output>fcs/throttle-pos-norm[5]</output>
    </fcs_function>
  </channel>
</system>
