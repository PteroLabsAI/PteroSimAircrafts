<?xml version="1.0"?>
<system name="H480 landing skid controller">
  <property value="0">h480/skid-request</property>
  <channel name="Landing skids">
    <switch name="h480/skid-request">
      <default value="h480/skid-request"/>
      <test logic="OR" value="0">
        position/h-agl-ft le 13.12336
        <test logic="AND">
          position/h-agl-ft le 22.96588
          velocities/h-dot-fps lt -3.28084
        </test>
      </test>
      <test logic="AND" value="1">
        position/h-agl-ft gt 19.68504
        velocities/h-dot-fps ge -1.64042
      </test>
    </switch>
    <actuator name="h480/skid-fraction">
      <input>h480/skid-request</input>
      <rate_limit>0.85</rate_limit>
      <clipto><min>0</min><max>1</max></clipto>
    </actuator>
    <fcs_function name="h480/skid-angle-deg">
      <function><product><value>55</value><property>h480/skid-fraction</property></product></function>
    </fcs_function>
    <fcs_function name="h480/skid-contact-position">
      <function><difference><value>1</value><property>h480/skid-fraction</property></difference></function>
      <output>gear/gear-pos-norm</output>
    </fcs_function>
  </channel>
</system>
