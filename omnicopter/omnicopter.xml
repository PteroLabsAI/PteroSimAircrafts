    <property value="0">fcs/omnicopter/rotor-7-command</property>
    <property value="0">fcs/omnicopter/rotor-7-speed</property>
    <channel name="Rotor 0">
      <switch name="fcs/omnicopter/rotor-0-response">
        <default value="40"/>
        <test logic="AND" value="80">
          fcs/omnicopter/rotor-0-command gt fcs/omnicopter/rotor-0-speed
        </test>
      </switch>
      <lag_filter name="fcs/omnicopter/rotor-0-speed">
        <input>fcs/omnicopter/rotor-0-command</input>
        <c1>fcs/omnicopter/rotor-0-response</c1>
      </lag_filter>
      <fcs_function name="fcs/omnicopter/rotor-0-static-thrust-lbs">
        <function>
          <product>
            <value>5.64207501</value>
            <property>fcs/omnicopter/rotor-0-speed</property>
            <abs><property>fcs/omnicopter/rotor-0-speed</property></abs>
          </product>
        </function>
      </fcs_function>
      <fcs_function name="fcs/omnicopter/rotor-0-thrust-lbs">
        <function>
          <product>
            <property>fcs/omnicopter/rotor-0-static-thrust-lbs</property>
            <max>
              <value>0</value>
              <difference>
                <value>1</value>
                <quotient>
                  <abs><sum>
                    <product><property>velocities/u-aero-fps</property><value>-0.788675184</value></product>
                    <product><property>velocities/v-aero-fps</property><value>-0.211325049</value></product>
                    <product><property>velocities/w-aero-fps</property><value>-0.577350135</value></product>
                  </sum></abs>
                  <value>82.0209974</value>
                </quotient>
              </difference>
            </max>
          </product>
        </function>
      </fcs_function>
      <pure_gain name="fcs/omnicopter/rotor-0-turn-rate">
        <input>fcs/omnicopter/rotor-0-speed</input><gain>15.9154943</gain>
      </pure_gain>
      <integrator name="fcs/omnicopter/rotor-0-turns">
        <input>fcs/omnicopter/rotor-0-turn-rate</input><c1>1</c1>
      </integrator>
      <fcs_function name="fcs/omnicopter/rotor-0-phase">
        <function>
          <fmod><sum><fmod><property>fcs/omnicopter/rotor-0-turns</property><value>1</value></fmod><value>1</value></sum><value>1</value></fmod>
