    <force name="rotor-0-thrust" frame="BODY" unit="LBS">
      <function><property>fcs/omnicopter/rotor-0-thrust-lbs</property></function>
      <location unit="M"><x>-0.1</x> <y>-0.1</y> <z>0.1</z></location>
      <direction><x>-0.788675184</x> <y>-0.211325049</y> <z>-0.577350135</z></direction>
    </force>
    <moment name="rotor-0-reaction" frame="BODY" unit="LBSFT">
      <function><product><property>fcs/omnicopter/rotor-0-static-thrust-lbs</property><value>-0.196850394</value></product></function>
      <direction><x>-0.788675184</x> <y>-0.211325049</y> <z>-0.577350135</z></direction>
    </moment>
    <force name="rotor-1-thrust" frame="BODY" unit="LBS">
