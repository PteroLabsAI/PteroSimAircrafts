      <!-- broadside: side silhouette 4.125 m2 x CD90 1.17 replaces CD0 as the flow turns sideways -->
      <function name="aero/force/Drag_beta">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <pow>
            <sin> <property>aero/beta-rad</property> </sin>
            <value> 2 </value>
          </pow>
          <value> 0.7332 </value>
        </product>
      </function>
    </axis>
    <axis name="SIDE">
      <!-- CYb from AVL, shaped sin(beta) cos(beta) like the broadside plate it becomes -->
      <function name="aero/force/Side_beta">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sin> <property>aero/beta-rad</property> </sin>
          <cos> <property>aero/beta-rad</property> </cos>
          <value> -0.7965 </value>
        </product>
      </function>
      <!-- CYr, AVL: the pusher shrouds behind the CG -->
      <function name="aero/force/Side_r">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>aero/bi2vel</property>
          <property>velocities/r-aero-rad_sec</property>
          <value> 1.3143 </value>
        </product>
      </function>
    </axis>
