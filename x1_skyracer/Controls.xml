<?xml version="1.0"?>
<!--
  Which channel from the autopilot drives what on this vehicle. The attributes are F450's (its Controls.xml):
  channel, the number the autopilot sends; type and index, the Propulsion.xml engine it drives; in / out absent
  meaning 0 to 1.

  Both autopilots send the ten engines in the model's own order, so channel n drives engine n. ArduPilot maps its
  OctaQuad X motors onto these outputs in its parameter file; PX4 assigns motor n+1 to output n.
-->
<control_bindings stack="ArduPilot">
  <binding stack="ArduPilot PX4" channel="0" type="Motor" index="0" label="FL upper"/>
  <binding stack="ArduPilot PX4" channel="1" type="Motor" index="1" label="FL lower"/>
  <binding stack="ArduPilot PX4" channel="2" type="Motor" index="2" label="FR upper"/>
  <binding stack="ArduPilot PX4" channel="3" type="Motor" index="3" label="FR lower"/>
  <binding stack="ArduPilot PX4" channel="4" type="Motor" index="4" label="RL upper"/>
  <binding stack="ArduPilot PX4" channel="5" type="Motor" index="5" label="RL lower"/>
  <binding stack="ArduPilot PX4" channel="6" type="Motor" index="6" label="RR upper"/>
  <binding stack="ArduPilot PX4" channel="7" type="Motor" index="7" label="RR lower"/>
  <binding stack="ArduPilot PX4" channel="8" type="Motor" index="8" label="pusher left"/>
  <binding stack="ArduPilot PX4" channel="9" type="Motor" index="9" label="pusher right"/>
</control_bindings>
