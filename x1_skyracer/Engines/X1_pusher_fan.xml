<propeller version="1.1" name="X1 pusher fan">
  <!-- Blades designed for the X1 concept model, not the manufacturer's fan: 11 twisted NACA 4409 blades, chord 63-92 mm, pitch 50-27 deg root to tip, r 0.10-0.32 m in a 26 in duct -->
  <!-- design point: 2000 N at 25 m/s, tip Mach 0.6, loading rising as sqrt(r), lift coefficient 0.9 root to 0.7 tip -->
  <!-- solid CFRP blades 1600 kg/m3 0.0801 + aluminium hub and spinner 2700 kg/m3 0.0266 kg m2; the motor rotor is not included -->
