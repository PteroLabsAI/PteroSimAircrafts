<?xml version="1.0"?>
<!-- X1 hybrid power: propane OPFPLG generator + accumulator on an 800 V bus feeding ten motor drives. -->
<!-- Designer's figures: 1500 hp continuous, 2000 hp burst; the generator follows demand slowly (boost and frequency), the accumulator covers the rest. -->
<!-- The autopilot writes fcs/throttle-cmd-norm[i]; this system writes fcs/throttle-pos-norm[i], the drive duty the motor sees. -->
<system name="X1 power">
  <!-- generator continuous electrical output, designer -->
  <property value="1500">propulsion/x1/gen-max-hp</property>
  <!-- generator + accumulator burst, designer -->
  <property value="2000">propulsion/x1/burst-max-hp</property>
  <!-- accumulator energy, the concept model's 10 kWh (designer wrote "10 kW") -->
  <property value="10">propulsion/x1/accum-usable-kwh</property>
  <!-- held back from burst for the power-off landing, rule book 3.6 (concept model) -->
  <property value="2">propulsion/x1/accum-reserve-kwh</property>
  <!-- accumulator peak power, concept model: what is left when the propane runs out -->
  <property value="1000">propulsion/x1/accum-peak-hp</property>
  <!-- recharge from generator surplus, concept model -->
  <property value="200">propulsion/x1/charge-max-hp</property>
  <!-- the accumulator's controller tapers charge near full and discharge near its limits over this band; chosen, no evidence -->
  <property value="0.1">propulsion/x1/accum-taper-kwh</property>
  <!-- 745.7 W/hp / (0.60 thermal efficiency x 46.35 MJ/kg propane LHV) x 2.2046 lb/kg x 3600 s/h, concept model figures -->
  <property value="0.21281">propulsion/x1/lb-per-hp-hr</property>
  <!-- 800 V bus / 745.7 W per hp -->
  <property value="1.07282">propulsion/x1/hp-per-amp</property>
  <!-- 745.7 W per hp / 3.6e6 J per kWh -->
  <property value="2.071389e-04">propulsion/x1/kwh-per-hp-s</property>
  <!-- inverter current limit as duty above/below back-EMF: 2 x rated current (EMRAX 268/348 peak/continuous torque) x coil R / bus V -->
  <property value="0.0600">propulsion/x1/drive-headroom</property>
  <!-- no-load rpm at full duty: velocityconstant x maxvolts of Engines/X1_lift_motor_upper.xml, X1_lift_motor_lower.xml, X1_pusher_motor.xml -->
  <property value="4073.9">propulsion/x1/upper-noload-rpm</property>
  <property value="2933.2">propulsion/x1/lower-noload-rpm</property>
  <property value="6645.1">propulsion/x1/pusher-noload-rpm</property>

