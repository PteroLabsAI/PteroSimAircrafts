  <propulsion>
    <!-- Rotor planes and spin from the X1 concept model. Engine index = rotor index; Systems/power.xml drives them. -->
    <!-- Lift fans thrust up (pitch 90), pushers forward. sense 1 = right-handed about the thrust axis: lift CCW from above, pusher CW from behind. -->
