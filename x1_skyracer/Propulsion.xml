      <thruster file="X1_lift_fan_upper">
        <location unit="IN">
          <x> -59.06 </x>
          <y> -67.79 </y>
          <z> 20.28 </z>
        </location>
        <orient unit="DEG">
          <roll> 0 </roll>
          <pitch> 90 </pitch>
          <yaw> 0 </yaw>
        </orient>
        <sense> 1 </sense>
      </thruster>
    </engine>
