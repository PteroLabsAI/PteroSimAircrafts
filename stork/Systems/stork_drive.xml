<?xml version="1.0"?>
<!-- The shaft and its two turboshafts: a governor on the rotors' common rpm wants (rotor torques of the last step + PID trim) x speed + losses,
     the engines share it as throttles (N1 demands), engine 0 (the combiner) passes their power to rotor 1's transmission, rotors 2-4 and the
     losses go on its brake. fcs/throttle-cmd-norm[0] above engage-norm engages it; below, both idle at no power and the rotors coast. -->
<system name="Stork drive">

  <property value="573.4">  fcs/drive/nominal-rpm </property>     <!-- Engines/stork_rotor_master.xml -->
  <property value="27.0">   fcs/drive/fixed-loss-hp </property>   <!-- at nominal speed: Pacc_0 20 [L6] + 2 % fPloss_xmsn [L6] x 1.33 [NT fxmsn, chosen drive limit 340 hp] x hover 265 hp -->
  <property value="800.0">  fcs/drive/max-brake-hp </property>    <!-- = maxbrakepower, Engines/stork_rotor_master.xml -->
  <property value="305.0">  fcs/drive/engine-mrp-hp </property>   <!-- one engine's MRP SLS [S18 Table 3, L6 nEngine 2]: the cap with both running and 100 % TQ -->
  <property value="319.41"> fcs/drive/engine-crp-hp </property>   <!-- = maxpower, Engines/stork_turboshaft.xml: its max N1, the cap with one engine out -->
  <property value="70.0">   fcs/drive/idle-n1 </property>         <!-- = idlen1 there: a running engine never falls below it -->
  <property value="638.82"> fcs/drive/combiner-hp </property>     <!-- = power, Engines/stork_combiner.xml -->
  <property value="0.00019040"> fcs/drive/hp-per-lbsft-rpm </property>  <!-- 2 pi / 60 / 550 -->
  <property value="0.5">    fcs/drive/engage-norm </property>     <!-- chosen: throttle command that engages it -->
  <property value="57.0">   fcs/drive/error-clip-rpm </property>  <!-- chosen: 10 % of nominal -->
  <property value="3000.0"> fcs/drive/trim-limit-lbsft </property> <!-- chosen: about the hover shaft torque, 2300 lb ft -->

  <channel name="drive">

    <switch name="fcs/drive/active-norm">
      <default value="0.0"/>
      <test value="1.0"> fcs/throttle-cmd-norm[0] GT fcs/drive/engage-norm </test>
    </switch>

    <fcs_function name="fcs/drive/speed-norm">
      <function>
        <quotient>
          <property> propulsion/engine[0]/rotor-rpm </property>
          <property> fcs/drive/nominal-rpm </property>
        </quotient>
      </function>
    </fcs_function>

    <!-- An engine's power at max N1 for this shaft speed: the turbine's n (2 - n) of Engines/stork_turboshaft.xml, x its lapse -->
    <fcs_function name="fcs/drive/full-hp[1]">
      <function>
        <product>
          <property> fcs/drive/engine-crp-hp </property>
          <property> propulsion/engine[1]/lapse-norm </property>
          <property> fcs/drive/speed-norm </property>
          <difference><value> 2.0 </value><property> fcs/drive/speed-norm </property></difference>
        </product>
      </function>
    </fcs_function>
    <fcs_function name="fcs/drive/full-hp[2]">
      <function>
        <product>
          <property> fcs/drive/engine-crp-hp </property>
          <property> propulsion/engine[2]/lapse-norm </property>
          <property> fcs/drive/speed-norm </property>
          <difference><value> 2.0 </value><property> fcs/drive/speed-norm </property></difference>
        </product>
      </function>
    </fcs_function>

    <!-- By N1, not set-running: PteroSim rewrites set-running from the engine command before every step -->
    <switch name="fcs/drive/running-norm[1]">
      <default value="0.0"/>
      <test value="1.0"> propulsion/engine[1]/n1 GE fcs/drive/idle-n1 </test>
    </switch>
    <switch name="fcs/drive/running-norm[2]">
      <default value="0.0"/>
      <test value="1.0"> propulsion/engine[2]/n1 GE fcs/drive/idle-n1 </test>
    </switch>

    <fcs_function name="fcs/drive/mrp-per-crp">
      <function><quotient><property> fcs/drive/engine-mrp-hp </property><property> fcs/drive/engine-crp-hp </property></quotient></function>
    </fcs_function>

    <!-- Throttle cap: MRP while the other engine runs, CRP (all of N1) once it has fallen below idle, as an OEI rating [NT p.137, Table 14-1] -->
    <switch name="fcs/drive/cap-norm[1]">
      <default value="1.0"/>
      <test value="fcs/drive/mrp-per-crp"> fcs/drive/running-norm[2] GT 0.5 </test>
    </switch>
    <switch name="fcs/drive/cap-norm[2]">
      <default value="1.0"/>
      <test value="fcs/drive/mrp-per-crp"> fcs/drive/running-norm[1] GT 0.5 </test>
    </switch>

    <fcs_function name="fcs/drive/available-hp">
      <function>
        <sum>
          <product>
            <property> fcs/drive/running-norm[1] </property>
            <property> fcs/drive/cap-norm[1] </property>
            <property> fcs/drive/full-hp[1] </property>
          </product>
          <product>
            <property> fcs/drive/running-norm[2] </property>
            <property> fcs/drive/cap-norm[2] </property>
            <property> fcs/drive/full-hp[2] </property>
          </product>
        </sum>
      </function>
    </fcs_function>

    <fcs_function name="fcs/drive/rpm-error">
      <function>
        <product>
          <property> fcs/drive/active-norm </property>
          <difference>
            <property> fcs/drive/nominal-rpm </property>
            <property> propulsion/engine[0]/rotor-rpm </property>
          </difference>
        </product>
      </function>
      <clipto>
        <min> -fcs/drive/error-clip-rpm </min>
        <max>  fcs/drive/error-clip-rpm </max>
      </clipto>
    </fcs_function>

    <fcs_function name="fcs/drive/rotors-2-4-hp">
      <function>
        <product>
          <property> fcs/drive/hp-per-lbsft-rpm </property>
          <property> propulsion/engine[0]/rotor-rpm </property>
          <sum>
            <property> propulsion/engine[1]/torque-lbsft </property>
            <property> propulsion/engine[2]/torque-lbsft </property>
            <property> propulsion/engine[3]/torque-lbsft </property>
          </sum>
        </product>
      </function>
    </fcs_function>

    <fcs_function name="fcs/drive/rotor-1-hp">
      <function>
        <product>
          <property> fcs/drive/hp-per-lbsft-rpm </property>
          <property> propulsion/engine[0]/rotor-rpm </property>
          <property> propulsion/engine[0]/torque-lbsft </property>
        </product>
      </function>
    </fcs_function>

    <!-- A fixed torque: the gearboxes and accessories stop with the shaft, so a rotor starts from rest -->
    <fcs_function name="fcs/drive/loss-hp">
      <function>
        <product>
          <property> fcs/drive/fixed-loss-hp </property>
          <property> fcs/drive/speed-norm </property>
        </product>
      </function>
    </fcs_function>

    <!-- -1 resets the integrator (off), 1 holds it (demand pinned in the error's direction), 0 integrates -->
    <switch name="fcs/drive/pid-inhibit">
      <default value="-1.0"/>
      <test logic="AND" value="1.0">
        fcs/drive/active-norm GT 0.5
        fcs/drive/demand-hp LE 0.0
        fcs/drive/rpm-error LT 0.0
      </test>
      <test logic="AND" value="1.0">
        fcs/drive/active-norm GT 0.5
        fcs/drive/demand-hp GE fcs/drive/available-hp-last
        fcs/drive/rpm-error GT 0.0
      </test>
      <test logic="AND" value="1.0">   <!-- the trim on its own clip: FGPID clips its output, not its integral -->
        fcs/drive/active-norm GT 0.5
        fcs/drive/trim-lbsft GE fcs/drive/trim-limit-lbsft
        fcs/drive/rpm-error GT 0.0
      </test>
      <test logic="AND" value="1.0">
        fcs/drive/active-norm GT 0.5
        fcs/drive/trim-lbsft LE -fcs/drive/trim-limit-lbsft
        fcs/drive/rpm-error LT 0.0
      </test>
      <test logic="AND" value="1.0">   <!-- a spool-up: no integral on the way, or it overshoots 9 % -->
        fcs/drive/active-norm GT 0.5
        fcs/drive/rpm-error GE fcs/drive/error-clip-rpm
      </test>
      <test value="0.0"> fcs/drive/active-norm GT 0.5 </test>
    </switch>

    <!-- lb ft per rpm: kp = I w 2 pi / 60 for I 196 slug ft2 [rotor file] and a 4.5 rad/s loop, integral time 3.3 s (chosen); a kd chattered -->
    <pid name="fcs/drive/trim-lbsft">
      <input> fcs/drive/rpm-error </input>
      <kp> 92.4 </kp>
      <ki> 28.0 </ki>
      <trigger> fcs/drive/pid-inhibit </trigger>
      <clipto><min> -fcs/drive/trim-limit-lbsft </min><max> fcs/drive/trim-limit-lbsft </max></clipto>
    </pid>

    <fcs_function name="fcs/drive/demand-hp">
      <function>
        <product>
          <property> fcs/drive/active-norm </property>
          <sum>
            <property> fcs/drive/rotor-1-hp </property>
            <property> fcs/drive/rotors-2-4-hp </property>
            <property> fcs/drive/loss-hp </property>
            <product>
              <property> fcs/drive/hp-per-lbsft-rpm </property>
              <property> propulsion/engine[0]/rotor-rpm </property>
              <property> fcs/drive/trim-lbsft </property>
            </product>
          </sum>
        </product>
      </function>
      <clipto>
        <min> 0.0 </min>
        <max> fcs/drive/available-hp </max>
      </clipto>
    </fcs_function>

    <!-- The clip demand-hp got: pid-inhibit runs before it, so it must compare last step's demand with last step's limit -->
    <fcs_function name="fcs/drive/available-hp-last">
      <function><property> fcs/drive/available-hp </property></function>
    </fcs_function>

    <!-- Overrunning clutches [S18 p.5]: an engine gives its power or nothing -->
    <fcs_function name="fcs/drive/delivered-hp[1]">
      <function><max><value> 0.0 </value><property> propulsion/engine[1]/power-hp </property></max></function>
    </fcs_function>
    <fcs_function name="fcs/drive/delivered-hp[2]">
      <function><max><value> 0.0 </value><property> propulsion/engine[2]/power-hp </property></max></function>
    </fcs_function>

    <!-- Load sharing: each engine takes half, and what the other does not give (spooling, capped or out), as twin FADECs matching torque -->
    <fcs_function name="fcs/drive/throttle[1]">
      <function>
        <quotient>
          <max>
            <product><value> 0.5 </value><property> fcs/drive/demand-hp </property></product>
            <difference><property> fcs/drive/demand-hp </property><property> fcs/drive/delivered-hp[2] </property></difference>
          </max>
          <property> fcs/drive/full-hp[1] </property>
        </quotient>
      </function>
      <clipto><min> 0.0 </min><max> fcs/drive/cap-norm[1] </max></clipto>
      <output> fcs/throttle-pos-norm[1] </output>
    </fcs_function>
    <fcs_function name="fcs/drive/throttle[2]">
      <function>
        <quotient>
          <max>
            <product><value> 0.5 </value><property> fcs/drive/demand-hp </property></product>
            <difference><property> fcs/drive/demand-hp </property><property> fcs/drive/delivered-hp[1] </property></difference>
          </max>
          <property> fcs/drive/full-hp[2] </property>
        </quotient>
      </function>
      <clipto><min> 0.0 </min><max> fcs/drive/cap-norm[2] </max></clipto>
      <output> fcs/throttle-pos-norm[2] </output>
    </fcs_function>

    <!-- The turbines' power, and what windmilling rotors 2-4 give the shared shaft past the losses: the brake below cannot drive -->
    <fcs_function name="fcs/drive/combiner-throttle">
      <function>
        <quotient>
          <sum>
            <property> fcs/drive/delivered-hp[1] </property>
            <property> fcs/drive/delivered-hp[2] </property>
            <max>
              <value> 0.0 </value>
              <product>
                <value> -1.0 </value>
                <sum>
                  <property> fcs/drive/rotors-2-4-hp </property>
                  <property> fcs/drive/loss-hp </property>
                </sum>
              </product>
            </max>
          </sum>
          <property> fcs/drive/combiner-hp </property>
        </quotient>
      </function>
      <output> fcs/throttle-pos-norm[0] </output>
    </fcs_function>

    <!-- Rotors 2-4 and the losses on rotor 1's brake, when they take power; when they give it, the combiner passes it on above -->
    <fcs_function name="fcs/drive/brake">
      <function>
        <quotient>
          <max>
            <value> 0.0 </value>
            <sum>
              <property> fcs/drive/rotors-2-4-hp </property>
              <property> fcs/drive/loss-hp </property>
            </sum>
          </max>
          <property> fcs/drive/max-brake-hp </property>
        </quotient>
      </function>
      <output> propulsion/engine[0]/brake-ctrl-norm </output>
    </fcs_function>

  </channel>

</system>
