<?xml version="1.0"?>
<!--
  Written from the model's <sensor> blocks. Metres and degrees, X forward / Y right / Z up, the
  same frame Visual.xml states. An attribute absent here means the component's own default.
-->
<sensors>
  <sensor type="barometer" name="air_pressure_sensor" hz="50"/>
  <sensor type="imu" name="imu_sensor" hz="250"/>
  <sensor type="gps" name="navsat_sensor" hz="30"/>
  <sensor type="camera" name="camera" xyz="0.1695 0 0"/>
  <sensor type="camera" name="gimbal_camera" xyz="0.035 0 0" parent="gimbal_1" field_of_view="115"/>
</sensors>
