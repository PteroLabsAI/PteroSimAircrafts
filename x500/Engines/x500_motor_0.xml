<?xml version="1.0"?>
<!--
  T-Motor (LIGPOWER) MN3510 KV630, 12N14P, the motor sold for 13-inch blades: velocity constant 630 rpm/V, internal
  resistance 65 milliohm, idle current 0.5 A at 10 V, 3-4S, 22 A / 495 W continuous. Its test table runs it at 14.8 V
  (ligpower.com/product/mn3510-kv630-motor-navigator-type.html; RobotShop's copy of the datasheet,
  ligpower_mn3510_kv630_high_performance_uav_motor_f).

  maxvolts is that bench voltage at the ESC's input. A pack in flight writes its own terminal voltage over it
  (propulsion/engine[n]/supply-volts). The table's current is the ESC's input current, throttle x current-amperes.
  With the 13x4.4 CF next to it at 14.8 V, table against model:
    throttle   rpm           thrust g      input A
     50 %      4500 / 4402    540 / 536     3.4 / 3.2
     65 %      5500 / 5646    860 / 881     6.1 / 6.6
     75 %      6300 / 6458   1100 / 1152    8.8 / 9.8
     85 %      6800 / 7255   1300 / 1455   11.8 / 13.9
    100 %      7300 / 8427   1500 / 1963   14.0 / 21.9
  The top two rows are not reproduced. With this Kv and resistance, the table's own rpm and current put 0.79 and 0.85
  of the 14.8 V across the motor there: the stand's ESC stops short of full output, which a motor driven at
  supply x throttle cannot show.
-->
<brushless_dc_motor name="x500_motor_0">
  <velocityconstant> 630 </velocityconstant>
  <coilresistance> 0.065 </coilresistance>
  <noloadcurrent> 0.5 </noloadcurrent>
  <maxvolts> 14.8 </maxvolts>
</brushless_dc_motor>
