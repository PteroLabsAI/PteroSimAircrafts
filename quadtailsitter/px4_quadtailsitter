#!/bin/sh
# PX4's 4018_gz_quadtailsitter (HEQ Swan K1) with HIL outputs, the simulated-battery bypass, the rotor cant
# declared, the propeller's measured torque coefficient and the flight parameters annotated below.

#
# @name Quadrotor + Tailsitter
#
# @type VTOL Quad Tailsitter
#

. ${R}etc/init.d/rc.vtol_defaults



param set-default MAV_TYPE 20

param set-default CA_AIRFRAME 4

param set-default CA_ROTOR_COUNT 4
# Rotor axes declared from the source model: the motors are canted +-10 deg on two axes, so the cant
# moments cancel only at equal thrust and any roll or pitch demand turns into a yaw torque the
# allocator must know about. KM signs follow the model's rotor senses (0 and 1 clockwise from above),
# the opposite pairing to 4018.
param set-default CA_ROTOR0_PX 0.16
param set-default CA_ROTOR0_PY 0.25
param set-default CA_ROTOR0_PZ 0.015
param set-default CA_ROTOR0_KM -0.014   # torque/thrust of the 9x6 propeller at hover, CP*D/(2*pi*CT) with the UIUC APC 9x6E data (CP 0.0515, CT 0.135, D 0.2286 m). The cant lever is 0.0705 m per N and the roll actuator in cruise is the difference of the two, so the stock airframe's 0.05 (3.6x the measured propeller) cancels the cant
param set-default CA_ROTOR0_AX -0.171
param set-default CA_ROTOR0_AY 0.1736
param set-default CA_ROTOR0_AZ -0.9698
param set-default CA_ROTOR1_PX -0.16
param set-default CA_ROTOR1_PY -0.25
param set-default CA_ROTOR1_PZ 0.015
param set-default CA_ROTOR1_KM -0.014
param set-default CA_ROTOR1_AX 0.171
param set-default CA_ROTOR1_AY -0.1736
param set-default CA_ROTOR1_AZ -0.9698
param set-default CA_ROTOR2_PX 0.16
param set-default CA_ROTOR2_PY -0.25
param set-default CA_ROTOR2_PZ 0.015
param set-default CA_ROTOR2_KM 0.014
param set-default CA_ROTOR2_AX -0.171
param set-default CA_ROTOR2_AY -0.1736
param set-default CA_ROTOR2_AZ -0.9698
param set-default CA_ROTOR3_PX -0.16
param set-default CA_ROTOR3_PY 0.25
param set-default CA_ROTOR3_PZ 0.015
param set-default CA_ROTOR3_KM 0.014
param set-default CA_ROTOR3_AX 0.171
param set-default CA_ROTOR3_AY 0.1736
param set-default CA_ROTOR3_AZ -0.9698

param set-default CA_SV_CS_COUNT 0

# --- PteroSim HIL output ---
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# --- sim battery/power bypass ---
param set-default COM_LOW_BAT_ACT 0
param set-default CBRK_SUPPLY_CHK 894281
param set-default BAT_LOW_THR 0.05
param set-default BAT_CRIT_THR 0.03
param set-default BAT_EMERGEN_THR 0.01

# --- hover point ---
param set-default MPC_THR_HOVER 0.40




param set-default FD_FAIL_R 70

param set-default FW_P_TC 0.6

param set-default FW_PR_I 0.3
param set-default FW_PR_P 0.5
param set-default FW_PSP_OFF 2
param set-default FW_RR_FF 0.1
param set-default FW_RR_I 0.1
param set-default FW_RR_P 0.2
param set-default FW_YR_FF 0 # make yaw rate controller very weak, only keep default P
param set-default FW_YR_I 0
param set-default FW_THR_TRIM 0.35
param set-default FW_THR_MAX 0.8
param set-default FW_THR_MIN 0.05
param set-default FW_T_CLMB_MAX 6
param set-default FW_T_HRATE_FF 0.5
param set-default FW_T_SINK_MAX 3
param set-default FW_T_SINK_MIN 1.6
param set-default FW_AIRSPD_STALL 8
param set-default FW_AIRSPD_MIN 10
param set-default FW_AIRSPD_TRIM 12   # the Swan K1's published 35-40 km in 50-60 min puts its cruise at 11-13 m/s. With a propeller whose thrust falls with advance ratio the margin over drag is 5.7x at 12 m/s and 1.7x at the stock 18
param set-default FW_AIRSPD_MAX 16

param set-default MC_AIRMODE 1   # roll/pitch only: with the measured propeller torque the yaw actuator is 0.055 m per N, five times what yaw airmode was compensating for in 4018
param set-default MC_YAWRATE_K 0.25   # the yaw actuator is 4.5x what the stock gains were tuned against (0.055 vs 0.012 m per N)
param set-default MAN_ARM_GESTURE 0
param set-default MC_ROLL_P 3
param set-default MC_PITCH_P 3
param set-default MC_ROLLRATE_P 0.3
param set-default MC_PITCHRATE_P 0.3

param set-default VT_ARSP_TRANS 10   # the front transition plateaus at 10.1 m/s at half throttle; a tailsitter has no thrust knob there (VT_F_TRANS_THR is standard-VTOL only), so the gate has to meet the airframe
param set-default VT_B_TRANS_DUR 5
param set-default VT_FW_DIFTHR_EN 7
param set-default VT_FW_DIFTHR_S_Y 1
param set-default VT_FW_DIFTHR_S_R 2.0   # differential thrust is the only roll actuator and its ceiling is about 24 deg/s (1.04 N*m against 2.5 N*m per rad/s of Clp damping at 12.4 m/s); at 0.7 the roll loop used 14% of it
param set-default VT_F_TRANS_DUR 3.0   # the one parameter that sets the pitch-over rate; at 1.5 s the pitch-over outruns the airspeed and the altitude loss approaches the 20 m VT_QC_T_ALT_LOSS, which is relative, so height does not help
param set-default VT_TYPE 0
param set-default COM_RC_IN_MODE 4

param set-default WV_EN 0

param set-default EKF2_FUSE_BETA 0

# --- path following: a control-surfaceless tailsitter rolls slowly, so the guidance period is long and the bank limit low ---
param set-default NPFG_PERIOD 20
param set-default FW_R_LIM 30
param set-default NPFG_DAMPING 0.85
