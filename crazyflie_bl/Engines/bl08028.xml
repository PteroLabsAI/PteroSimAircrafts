<?xml version="1.0"?>
<!-- 08028-10000KV motor on a duty-cycle ESC: throttle = duty * Vbat / maxvolts. -->
<brushless_dc_motor name="08028-10000KV">
  <maxvolts> 4.2 </maxvolts> <!-- V, full 1S LiPo cell -->
  <velocityconstant> 11958 </velocityconstant> <!-- rpm/V, train flights, rotor speed over 0.5 s windows from PWM*Vbat (datasheet 10000) -->
  <coilresistance> 1.078 </coilresistance> <!-- ohm, train flights (datasheet 0.52, winding only); includes ESC and wiring -->
  <noloadcurrent> 0.000 </noloadcurrent> <!-- A, train flights, fit at its lower bound (datasheet 0.40 A at 4 V, no load) -->
</brushless_dc_motor>
