<?xml version="1.0"?>

<!-- NASA Ingenuity Mars Helicopter - Propulsion
     Coaxial counter-rotating rotors, each driven by its own electric motor; the six swashplate servos are the
     flight control system's (Systems/rotor_control.xml)
     Hubs: measured on NASA's 3D model, 0.4531 and 0.3541 m above its origin (its feet at -0.005); Gear.xml's feet
     0.13 m under the CG put the CG at 0.125, so the hubs are 0.3281 and 0.2291 m above it (structural Z up; spacing
     0.099 m = NASA/TM-20240001510 Table 1).
     The engines are named so Visual.xml can bind a propeller mesh to each.
-->

<propulsion>

  <!-- Upper rotor motor - CW from above -->
  <engine file="ingenuity_motor" name="rotor_upper">
    <thruster file="ingenuity_upper_rotor">
      <location unit="M">
        <x> 0.0 </x>
        <y> 0.0 </y>
        <z> 0.3281 </z>
      </location>
      <orient unit="DEG">
        <roll>   0.0 </roll>
        <pitch> 90.0 </pitch>
        <yaw>    0.0 </yaw>
      </orient>
      <sense> -1 </sense>
    </thruster>
  </engine>

  <!-- Lower rotor motor - CCW from above -->
  <engine file="ingenuity_motor" name="rotor_lower">
    <thruster file="ingenuity_lower_rotor">
      <location unit="M">
        <x> 0.0 </x>
        <y> 0.0 </y>
        <z> 0.2291 </z>
      </location>
      <orient unit="DEG">
        <roll>   0.0 </roll>
        <pitch> 90.0 </pitch>
        <yaw>    0.0 </yaw>
      </orient>
      <sense> 1 </sense>
    </thruster>
  </engine>

  <!-- No tank: the electric motors burn nothing, and the battery is inside Mass.xml's 1.8 kg. -->

</propulsion>
