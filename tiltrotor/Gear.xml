<?xml version="1.0"?>
<!--
  One contact per box collision, placed at the box's lowest corner with its own rotation applied.
  The friction and spring figures are NOT from the model: SDF states surface properties this format
  has no room for, so these are ordinary values and the first thing to tune if it bounces.

  BOGEY where the collision sits on a link that turns on a revolute joint nothing drives, which is
  a wheel, and STRUCTURE everywhere else. The difference is real: a BOGEY rolls freely fore and aft,
  so a belly written as one cannot be held by friction, does not resist a takeoff run and never
  decelerates on rollout, while a wheel written as STRUCTURE drags the aeroplane to a halt.
-->
  <ground_reactions>
    <contact type="STRUCTURE" name="base_link_collision_0">
      <location unit="M">
        <x> 0.285 </x>
        <y> 1.072 </y>
        <z> -0.105 </z>
      </location>
      <static_friction> 0.8 </static_friction>
      <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff unit="N/M"> 553.5 </spring_coeff>
      <damping_coeff unit="N/M/SEC"> 37.32 </damping_coeff>
    </contact>
