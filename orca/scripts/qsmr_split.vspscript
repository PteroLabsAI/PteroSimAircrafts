// QSMR into two OBJs: the body (everything outside but the rotor) and the rotor (blades and hub), finer than saved.
// Paths are relative to the working directory because vspscript takes no script arguments: run it where NASA's
// qsmr-vsp.zip is unpacked (meshes/NOTICE), as vspscript -script qsmr_split.vspscript.

const string InFile = "QEU2023-SMR-6pax-turbo-notar_450fps.vsp3";
const string OutDir = "qsmr_split";
// Chosen: three times the saved tessellation each way; twice left the NOTAR inlet and the cowlings faceted.
const int TessFactor = 3;
// Chosen: the bodies whose shallow intersections show as steps (fuselage under the pylon, the NOTAR inlet) finer still.
const int FineTessFactor = 5;
// The blades keep the saved tessellation: its structured grid shades clean, where a finer one cut down to a size streaks.
const int BladeTessFactor = 1;

bool IsFine(const string &in name)
{
    return name == "Fuselage" || name == "Rotor_1_pylon" || name == "NOTAR-Inlet";
}

bool IsInside(const string &in name)
{
    return name.findFirst("Payload") >= 0 || name.findFirst("Seat") >= 0 || name.findFirst("FuelTank") >= 0 || name == "Rotor_1_disk";
}

bool IsRotor(const string &in name)
{
    return name == "Rotor_1_blades" || name == "Rotor_1_hub";
}

void Load()
{
    ClearVSPModel();
    ReadVSPFile(InFile);
    Update();
    array<string> @geoms = FindGeoms();
    for (uint i = 0; i < geoms.size(); i++)
    {
        string tess_u = GetParm(geoms[i], "Tess_U", "Shape");
        string tess_w = GetParm(geoms[i], "Tess_W", "Shape");
        string name = GetGeomName(geoms[i]);
        double factor = IsFine(name) ? FineTessFactor : (name == "Rotor_1_blades" ? BladeTessFactor : TessFactor);
        if (ValidParm(tess_u)) { SetParmVal(tess_u, GetParmVal(tess_u) * factor); }
        if (ValidParm(tess_w)) { SetParmVal(tess_w, GetParmVal(tess_w) * factor); }
    }
    Update();
}

void ExportKeeping(bool rotor, const string &in file)
{
    Load();
    array<string> @geoms = FindGeoms();
    array<string> doomed;
    for (uint i = 0; i < geoms.size(); i++)
    {
        string name = GetGeomName(geoms[i]);
        if (IsInside(name) || IsRotor(name) != rotor) { doomed.insertLast(geoms[i]); }
        else { Print("keep " + name); }
    }
    for (uint i = 0; i < doomed.size(); i++) { DeleteGeom(doomed[i]); }
    Update();
    ExportFile(OutDir + "/" + file, SET_ALL, EXPORT_OBJ);
    Print("exported " + file);
}

void main()
{
    ExportKeeping(false, "body.obj");
    ExportKeeping(true, "rotor.obj");
}
