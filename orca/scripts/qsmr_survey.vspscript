// The QSMR's components (placement, extent) and its sub-surfaces (NOTAR slot, jet, inlet) as 3D points, for the FDM.
// The path is relative to the working directory because vspscript takes no script arguments: run it where NASA's
// qsmr-vsp.zip is unpacked (meshes/NOTICE), as vspscript -script qsmr_survey.vspscript.

const string InFile = "QEU2023-SMR-6pax-turbo-notar_450fps.vsp3";
const int Samples = 24;   // per parameter direction when sampling a surface's extent

string Fmt(vec3d p)
{
    return formatFloat(p.x(), "", 0, 3) + " " + formatFloat(p.y(), "", 0, 3) + " " + formatFloat(p.z(), "", 0, 3);
}

void Extent(const string &in geom, int surf, double u0, double u1, double w0, double w1, vec3d &out lo, vec3d &out hi)
{
    lo = vec3d(1e9, 1e9, 1e9);
    hi = vec3d(-1e9, -1e9, -1e9);
    for (int i = 0; i <= Samples; i++)
    {
        for (int j = 0; j <= Samples; j++)
        {
            vec3d p = CompPnt01(geom, surf, u0 + (u1 - u0) * i / Samples, w0 + (w1 - w0) * j / Samples);
            lo = vec3d(Min(lo.x(), p.x()), Min(lo.y(), p.y()), Min(lo.z(), p.z()));
            hi = vec3d(Max(hi.x(), p.x()), Max(hi.y(), p.y()), Max(hi.z(), p.z()));
        }
    }
}

void main()
{
    ClearVSPModel();
    ReadVSPFile(InFile);
    Update();
    array<string> @geoms = FindGeoms();
    for (uint g = 0; g < geoms.size(); g++)
    {
        string id = geoms[g];
        Print("GEOM " + GetGeomName(id) + " type " + GetGeomTypeName(id) + " surfs " + GetNumMainSurfs(id));
        array<string> xf = {"X_Rel_Location", "Y_Rel_Location", "Z_Rel_Location", "X_Rel_Rotation", "Y_Rel_Rotation", "Z_Rel_Rotation"};
        string line = "  xform";
        for (uint q = 0; q < xf.size(); q++) { line += " " + xf[q] + "=" + formatFloat(GetParmVal(GetParm(id, xf[q], "XForm")), "", 0, 3); }
        Print(line);
        for (int s = 0; s < GetNumMainSurfs(id); s++)
        {
            vec3d lo, hi;
            Extent(id, s, 0, 1, 0, 1, lo, hi);
            Print("  surf " + s + " min " + Fmt(lo) + " max " + Fmt(hi));
        }
        array<string> @subs = GetSubSurfIDVec(id);
        for (uint k = 0; k < subs.size(); k++)
        {
            Print("  SUB " + GetSubSurfName(subs[k]));
            array<string> @parms = GetSubSurfParmIDs(subs[k]);
            double cu = -1, cw = -1, lu = 0, lw = 0;
            for (uint p = 0; p < parms.size(); p++)
            {
                string n = GetParmName(parms[p]);
                double v = GetParmVal(parms[p]);
                Print("    " + n + " = " + formatFloat(v, "", 0, 4));
                if (n == "Center_U") { cu = v; }
                if (n == "Center_W") { cw = v; }
                if (n == "U_Length") { lu = v; }
                if (n == "W_Length") { lw = v; }
            }
            if (cu >= 0)
            {
                for (int s = 0; s < GetNumMainSurfs(id); s++)
                {
                    vec3d lo, hi;
                    Extent(id, s, cu - lu / 2, cu + lu / 2, cw - lw / 2, cw + lw / 2, lo, hi);
                    Print("    on surf " + s + " min " + Fmt(lo) + " max " + Fmt(hi) + " centre " + Fmt(CompPnt01(id, s, cu, cw)));
                    for (int e = 0; e <= 4; e++)
                    {
                        double u = cu - lu / 2 + lu * e / 4;
                        Print("    along " + formatFloat(u, "", 0, 4) + " lower " + Fmt(CompPnt01(id, s, u, cw - lw / 2)) + " mid " + Fmt(CompPnt01(id, s, u, cw)) + " upper " + Fmt(CompPnt01(id, s, u, cw + lw / 2)));
                    }
                }
            }
        }
    }
}
